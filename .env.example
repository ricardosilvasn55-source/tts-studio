# Provedor ativo (registrado em src/providers/index.js)
TTS_PROVIDER=azure
# Azure AI Speech: chave do recurso "Speech" no portal Azure
TTS_API_KEY=
# Troque a região (ex.: brazilsouth, eastus) pela do seu recurso
TTS_API_URL=https://brazilsouth.tts.speech.microsoft.com/cognitiveservices/v1
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
MAX_CHARS=20000
